<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 11 and lower. Privacy: nothing is uploaded to cloud backup
   (allowBackup="false" in the manifest; this excludes everything as a second guard).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
