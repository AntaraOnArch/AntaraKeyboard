<?xml version="1.0" encoding="utf-8"?>
<!-- Round icon button of the main screen; same colors as main_button_rounded -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/special_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/special_fill_pressed" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <solid android:color="@color/main_button_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/main_button_border" />
        </shape>
    </item>

</selector>
