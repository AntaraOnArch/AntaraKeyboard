<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background with border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/main_spinner_bg_light" />
            <stroke
                android:width="1.5dp"
                android:color="@color/main_spinner_border_light" />
            <corners android:radius="8dp" />
            <padding
                android:left="12dp"
                android:top="8dp"
                android:right="36dp"
                android:bottom="8dp" />
        </shape>
    </item>
    <!-- Dropdown arrow -->
    <item
        android:width="24dp"
        android:height="24dp"
        android:gravity="center_vertical|end"
        android:right="8dp">
        <rotate
            android:fromDegrees="45"
            android:pivotX="50%"
            android:pivotY="40%">
            <shape android:shape="rectangle">
                <size
                    android:width="8dp"
                    android:height="8dp" />
                <solid android:color="@color/main_spinner_border_light" />
            </shape>
        </rotate>
    </item>
</layer-list>
