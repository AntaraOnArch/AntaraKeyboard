<?xml version="1.0" encoding="utf-8"?>
<!-- paddingMode="stack": the arrow layer is not inset by the background padding -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingMode="stack">
    <!-- Background with border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/main_spinner_bg" />
            <stroke
                android:width="1.5dp"
                android:color="@color/main_spinner_border" />
            <corners android:radius="8dp" />
            <padding
                android:left="12dp"
                android:top="8dp"
                android:right="36dp"
                android:bottom="8dp" />
        </shape>
    </item>
    <!-- Dropdown arrow at the right edge -->
    <item
        android:width="24dp"
        android:height="24dp"
        android:drawable="@drawable/ic_spinner_arrow"
        android:end="10dp"
        android:gravity="center_vertical|end" />
</layer-list>
