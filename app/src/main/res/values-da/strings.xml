    <string name="tutorial_enable_title">Slå tastaturet til</string>
    <string name="tutorial_enable_text">Tryk på „%1$s“, slå Antara til på listen, og kom tilbage hertil.</string>
    <string name="tutorial_choose_title">Gør det til dit tastatur</string>
    <string name="tutorial_choose_text">Tryk på „%1$s“, og vælg Antara.</string>
    <string name="tutorial_input_hint">Øv her</string>
    <string name="tutorial_not_active">Antara er ikke dit aktive tastatur endnu – øvelsen har brug for det.</string>
    <string name="tutorial_capitals_text">Stryg op på et bogstav, så skrives det med stort. Skriv to store bogstaver.</string>
    <string name="tutorial_caps_title">Kun store bogstaver</string>
    <string name="tutorial_caps_text">Shift (⇧) er faktisk caps lock: tryk én gang, og hvert bogstav er stort, indtil du trykker igen. Skriv 5 vilkårlige store bogstaver – med Shift eller ved at stryge opad, det er lige meget.</string>
    <string name="tutorial_punctuation_text">Stryg op på . for et komma og på ? for et udråbstegn. Skriv begge.</string>
    <string name="tutorial_delete_title">Slet med et strøg</string>
    <string name="tutorial_delete_text">Stryg til venstre på tasterne eller området omkring dem – jo længere strøg, jo hurtigere sletter det.</string>
    <string name="tutorial_restore_title">Hent teksten tilbage</string>
    <string name="tutorial_restore_text">Skriv ét bogstav eller tegn, stryg til venstre for at slette det og til højre for at hente det tilbage. Gør det 3 gange.</string>
    <string name="tutorial_long_press_text">Hold en tast, glid hen til et specialbogstav, og løft fingeren. Skriv et specialbogstav.</string>
    <string name="tutorial_long_press_example">Særlige bogstaver i dit sprog – hold en af disse taster nede:\n%1$s</string>
    <string name="tutorial_emoji_text">Stryg op på 123 (eller tryk på 😊), og vælg en emoji.</string>
    <string name="tutorial_sample_text">Antara</string>
    <string name="tutorial_swap_title">Dit eget bogstavlayout</string>
    <string name="tutorial_swap_text">„%1$s“: tryk på to taster (eller træk den ene hen på den anden), så bytter de plads. QWERTY, AZERTY og andre skabeloner findes også.</string>
    <string name="tutorial_bind_title">Emoji ved langt tryk</string>
    <string name="tutorial_bind_text">„%1$s“: tryk på en tast, og tilføj en emoji, et bogstav eller din egen tekst – den vises, når du holder tasten.</string>
    <string name="tutorial_themes_title">Temaer og baggrund</string>
    <string name="tutorial_themes_text">„%1$s“: lyst, mørkt, gennemsigtigt eller animeret RGB. „%2$s“: farv hver del af tastaturet.</string>
    <string name="tutorial_features_title">Hvad du ellers kan</string>
    <string name="tutorial_help_note">Vil du se det igen? „%1$s“ (?) → helt nederst.</string>
    <string name="help_group_keyboard">Tastatur</string>
    <string name="help_group_app">App</string>
    <string name="help_group_gestures">Bevægelser på tastaturet</string>
    <string name="help_enable">Slår Antara-tastaturet til på Androids liste over tastaturer. Kun nødvendigt én gang efter installationen.</string>
    <string name="help_choose">Gør Antara til det tastatur, du skriver med. Du kan også skifte tastatur med tastaturikonet i navigationslinjen.</string>
    <string name="help_key_shape">Sekskantede, trekantede, runde eller terningformede taster. Eksemplet nedenfor viser den valgte form.</string>
    <string name="help_rows">3, 4 eller 5 rækker taster. Layouts, sideknapper og tegn ved langt tryk følger antallet af rækker.</string>
    <string name="help_key_height">Gør tasterne højere eller lavere. Kun højden ændres, aldrig bredden eller afstanden mellem tasterne.</string>
    <string name="help_row_spacing">Tilføjer eller fjerner plads mellem tasterækkerne. Intet andet ændres.</string>
    <string name="help_side_offsets">Flytter sideknapperne lidt til venstre eller højre, f.eks. væk fra en afrundet skærmkant, separat for stående og liggende visning.</string>
    <string name="help_layout_keys">Vælg en skabelon (QWERTZ, QWERTY, AZERTY, Dvorak…) eller placer bogstaverne selv: tryk på to taster, eller træk én over på en anden for at bytte dem. Det numeriske layout er nedenfor; 0–9, ABC og Enter kan kun flyttes.</string>
    <string name="help_layout_side">Knapperne ved skærmkanterne. Tryk på en for at give den en handling (Shift, Backspace, Enter, mellemrum, et tegn eller emojivælgeren), træk dem for at ændre rækkefølgen.</string>
    <string name="help_layout_horizontal">Symbolerne mellem tastaturets to halvdele i liggende visning. Hvert enkelt kan ændres eller efterlades tomt.</string>
    <string name="help_layout_emoji">Hvor emojikategorierne vises, og rækkefølge og side for knapperne til luk, slet og mellemrum.</string>
    <string name="help_saved_layouts">Dine gemte layouts og de sikkerhedskopier, der laves ved nulstilling og import. Se en, gendan layout og/eller farver, omdøb eller slet.</string>
    <string name="help_lp_alphabet">Når du holder et bogstav, vises ekstra tegn. Tryk på en tast her for at tilføje specialbogstaver, symboler eller emoji.</string>
    <string name="help_lp_numeric">Det samme for tasterne i det numeriske layout.</string>
    <string name="help_lp_my_binds">Alle taster med tegn ved langt tryk på én liste. Tryk på en for at ændre den.</string>
    <string name="help_lp_custom">Lægger en vilkårlig tekst på en tasts lange tryk, f.eks. din e-mailadresse eller en hel besked. Den skrives præcis som skrevet.</string>
    <string name="help_colors_space">Mellemrumstasternes farve: temaets farve, begge ens eller hver sin.</string>
    <string name="help_colors_enter">Baggrunds- og ikonfarve for Enter. Det valgte tegn i pop op-vinduet ved langt tryk bruger dem også.</string>
    <string name="help_colors_side">Ikon- og baggrundsfarve for sideknapperne eller slet ingen baggrund.</string>
    <string name="help_colors_keys">Én farve til alle taster, eller tryk på en tast for at give den sin egen farve.</string>
    <string name="help_colors_background">Tastaturbaggrund: efter tema, mørk, lys eller din egen farve.</string>
    <string name="help_colors_theme_defaults">Farverne, som det lyse og mørke tema bruger overalt, hvor temafarver er slået til.</string>
    <string name="help_language">Sproget i appen og tastaturets bogstaver (latinsk, kyrillisk eller græsk). På tastaturet skifter du det ved at holde begge mellemrumstaster i 4 sekunder.</string>
    <string name="help_theme">Lys eller Mørk, gennemsigtig baggrund, Tilpasset (dine gemte layouts) eller de animerede RGB Smooth og RGB Wild.</string>
    <string name="help_rgb">Hastighed, mætning og lysstyrke for RGB-animationen.</string>
    <string name="help_vibration">En kort vibration ved hvert tastetryk.</string>
    <string name="help_suggestions">Op til tre ord over tasterne; tryk på et for at bruge det. Ingen autokorrektur, og intet du skriver gemmes.</string>
    <string name="help_double_space_period">To mellemrum efter et ord skriver punktum og mellemrum. Ikke i adgangskoder, e-mailadresser eller links.</string>
    <string name="help_reset">Farver, layout eller begge til standard. Den nuværende tilstand gemmes først i Gemte layouts; tegn ved langt tryk og tasteformen bevares.</string>
    <string name="help_export">Gemmer alle indstillinger i en fil, f.eks. til en ny telefon. Seneste emoji er ikke med.</string>
    <string name="help_import">Indlæser indstillinger fra en eksporteret fil. Dine nuværende indstillinger gemmes som sikkerhedskopi i Gemte layouts.</string>
    <string name="help_about">Version, privatliv og open source-licenser.</string>
    <string name="help_q_capitals">Store bogstaver</string>
    <string name="help_capitals">Stryg op på et bogstav for ét stort bogstav. Shift holder store bogstaver slået til, indtil du trykker på den igen.</string>
    <string name="help_q_delete">Slet og gendan tekst</string>
    <string name="help_delete">Stryg til venstre på tasterne eller rummet omkring dem for at slette, til højre for at få teksten tilbage. Jo længere strøg, jo hurtigere. At holde Backspace sletter også.</string>
    <string name="help_q_special">Specialtegn</string>
    <string name="help_special">Hold en tast, glid hen til et tegn, og løft fingeren.</string>
    <string name="help_q_punctuation">Komma og udråbstegn</string>
    <string name="help_punctuation">Stryg op på . for komma og på ? for udråbstegn.</string>
    <string name="help_q_emoji">Emoji</string>
    <string name="help_emoji">Tryk på 😊, eller stryg op på 123 (med 4 og 5 rækker).</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_privacy">Antara tastatur har ingen internetadgang og indsamler intet. Alt, hvad du skriver, og alle indstillinger bliver på din enhed, medmindre du selv eksporterer dem.</string>
    <string name="about_licenses">Open source-licenser</string>
    <string name="about_licenses_hint">Tryk på et punkt for at læse licensen.</string>
