    <string name="help_enable">Bekapcsolja az Antara billentyűzetet az Android billentyűzetlistájában. Telepítés után egyszer kell.</string>
    <string name="help_choose">Az Antarát teszi azzá a billentyűzetté, amellyel gépel. A navigációs sáv billentyűzetikonjával is válthat.</string>
    <string name="help_key_shape">Hatszög, háromszög, kör vagy kocka alakú billentyűk. Az alábbi előnézet a kiválasztott formát mutatja.</string>
    <string name="help_rows">3, 4 vagy 5 billentyűsor. A kiosztások, oldalsó gombok és hosszú nyomásos karakterek a sorok számát követik.</string>
    <string name="help_key_height">Magasabbá vagy alacsonyabbá teszi a billentyűket. Csak a magasság változik, a szélesség és a billentyűk közti hézag soha.</string>
    <string name="help_row_spacing">Növeli vagy csökkenti a billentyűsorok közti helyet. Más nem változik.</string>
    <string name="help_side_offsets">Kicsit balra vagy jobbra tolja az oldalsó gombokat, pl. a lekerekített képernyőszéltől távolabb, külön álló és fekvő nézetben.</string>
    <string name="help_layout_keys">Válasszon sablont (QWERTZ, QWERTY, AZERTY, Dvorak…), vagy rendezze el saját maga a betűket: koppintson két billentyűre, vagy húzzon egyet a másikra a cseréhez. Alatta a számkiosztás; a 0–9, az ABC és az Enter csak áthelyezhető.</string>
    <string name="help_layout_side">A képernyő szélein lévő gombok. Koppintson egyre, hogy műveletet adjon neki (Shift, Backspace, Enter, szóköz, karakter vagy emojiválasztó), húzza őket a sorrend módosításához.</string>
    <string name="help_layout_horizontal">A billentyűzet két fele közti szimbólumok fekvő nézetben. Bármelyik módosítható vagy üresen hagyható.</string>
    <string name="help_layout_emoji">Hol jelennek meg az emojikategóriák, valamint a bezárás, törlés és szóköz gombok sorrendje és oldala.</string>
    <string name="help_saved_layouts">A mentett kiosztásai és a visszaállításkor és importáláskor készült biztonsági mentések. Előnézet, kiosztás és/vagy színek visszaállítása, átnevezés vagy törlés.</string>
    <string name="help_lp_alphabet">Egy betű nyomva tartása további karaktereket mutat. Itt koppintson egy billentyűre, hogy különleges betűket, szimbólumokat vagy emojikat adjon hozzá.</string>
    <string name="help_lp_numeric">Ugyanez a számkiosztás billentyűire.</string>
    <string name="help_lp_my_binds">Minden hosszú nyomásos karakterrel rendelkező billentyű egy listában. Koppintson egyre a módosításhoz.</string>
    <string name="help_lp_custom">Bármilyen szöveget tesz egy billentyű hosszú nyomására, pl. az e-mail-címét vagy egy egész üzenetet. Pontosan úgy íródik be, ahogy megadta.</string>
    <string name="help_colors_space">A szóközbillentyűk színe: a téma színe, mindkettő azonos, vagy mindegyiknek saját.</string>
    <string name="help_colors_enter">Az Enter háttér- és ikonszíne. A hosszú nyomásos ablakban kiválasztott karakter is ezeket használja.</string>
    <string name="help_colors_side">Az oldalsó gombok ikon- és háttérszíne, vagy háttér nélkül.</string>
    <string name="help_colors_keys">Egy szín minden billentyűnek, vagy koppintson egy billentyűre, hogy saját színt kapjon.</string>
    <string name="help_colors_background">A billentyűzet háttere: téma szerint, sötét, világos vagy saját szín.</string>
    <string name="help_colors_theme_defaults">A világos és sötét téma színei, amelyeket mindenhol használ, ahol a téma színei be vannak kapcsolva.</string>
    <string name="help_language">Az alkalmazás és a billentyűzet betűinek nyelve (latin, cirill vagy görög). A billentyűzeten mindkét szóköz 4 másodperces nyomva tartásával váltható.</string>
    <string name="help_theme">Világos vagy sötét, átlátszó háttér, Egyéni (mentett kiosztások) vagy az animált RGB Smooth és RGB Wild.</string>
    <string name="help_rgb">Az RGB-animáció sebessége, telítettsége és fényereje.</string>
    <string name="help_vibration">Rövid rezgés minden billentyűnyomáskor.</string>
    <string name="help_suggestions">Legfeljebb három szó a billentyűk felett; koppintson egyre a használatához. Nincs automatikus javítás, és semmi, amit gépel, nem kerül mentésre.</string>
    <string name="help_double_space_period">Egy szó után két szóköz pontot és szóközt ír. Jelszavakban, e-mail-címekben és linkekben nem.</string>
    <string name="help_reset">Színek, kiosztás vagy mindkettő alapértelmezésre. Az aktuális állapot előbb a Mentett kiosztások közé kerül; a hosszú nyomásos karakterek és a billentyűforma megmaradnak.</string>
    <string name="help_export">Minden beállítást fájlba ment, pl. új telefonra való átvitelhez. A legutóbbi emojik nincsenek benne.</string>
    <string name="help_import">Beállításokat tölt be egy exportált fájlból. A jelenlegi beállítások biztonsági mentésként a Mentett kiosztások közé kerülnek.</string>
    <string name="help_about">Verzió, adatvédelem és nyílt forráskódú licencek.</string>
    <string name="help_q_capitals">Nagybetűk</string>
    <string name="help_capitals">Húzza felfelé az ujját egy betűn egy nagybetűért. A Shift bekapcsolva tartja a nagybetűket, amíg újra nem koppint rá.</string>
    <string name="help_q_delete">Szöveg törlése és visszaállítása</string>
    <string name="help_delete">Húzza balra az ujját a billentyűkön vagy a körülöttük lévő helyen a törléshez, jobbra a szöveg visszahozásához. Minél hosszabb a húzás, annál gyorsabb. A Backspace nyomva tartása is töröl.</string>
    <string name="help_q_special">Különleges karakterek</string>
    <string name="help_special">Tartson nyomva egy billentyűt, csúsztassa az ujját egy karakterre, és emelje fel.</string>
    <string name="help_q_punctuation">Vessző és felkiáltójel</string>
    <string name="help_punctuation">Húzza felfelé az ujját a . billentyűn vesszőért, a ? billentyűn felkiáltójelért.</string>
    <string name="help_q_emoji">Emojik</string>
    <string name="help_emoji">Koppintson a 😊-ra, vagy húzza felfelé az ujját a 123-on (4 és 5 sornál).</string>
