    <string name="tutorial_enable_title">Kapcsolja be a billentyűzetet</string>
    <string name="tutorial_enable_text">Koppintson a(z) „%1$s” gombra, kapcsolja be az Antarát a listában, és jöjjön vissza ide.</string>
    <string name="tutorial_choose_title">Legyen ez a billentyűzete</string>
    <string name="tutorial_choose_text">Koppintson a(z) „%1$s” gombra, és válassza az Antarát.</string>
    <string name="tutorial_input_hint">Gyakoroljon itt</string>
    <string name="tutorial_not_active">Az Antara még nem az aktív billentyűzet – a gyakorláshoz szükség van rá.</string>
    <string name="tutorial_capitals_text">Húzza felfelé az ujját egy betűn, és nagybetűként íródik. Írjon két nagybetűt.</string>
    <string name="tutorial_caps_title">Csak nagybetűk</string>
    <string name="tutorial_caps_text">A Shift (⇧) valójában caps lock: koppintson rá egyszer, és minden betű nagybetű lesz, amíg újra nem koppint. Írjon be bármilyen 5 nagybetűt – Shifttel vagy felfelé húzással, mindegy.</string>
    <string name="tutorial_punctuation_text">Húzza felfelé az ujját a . gombon vesszőért és a ? gombon felkiáltójelért. Írja be mindkettőt.</string>
    <string name="tutorial_delete_title">Törlés húzással</string>
    <string name="tutorial_delete_text">Húzza balra az ujját a billentyűkön vagy körülöttük – minél hosszabb a mozdulat, annál gyorsabban töröl.</string>
    <string name="tutorial_restore_title">Szöveg visszahozása</string>
    <string name="tutorial_restore_text">Írjon be egy betűt vagy jelet, húzza balra a törléshez és jobbra a visszahozáshoz. Ismételje meg 3-szor.</string>
    <string name="tutorial_long_press_text">Tartson lenyomva egy billentyűt, csúsztasson egy különleges betűre, és emelje fel az ujját. Írjon be egy különleges betűt.</string>
    <string name="tutorial_long_press_example">A nyelve különleges betűi – tartsa lenyomva bármelyik billentyűt ezek közül:\n%1$s</string>
    <string name="tutorial_emoji_text">Húzza felfelé az ujját a 123-on (vagy koppintson a 😊-ra), és válasszon egy emojit.</string>
    <string name="tutorial_sample_text">Antara</string>
    <string name="tutorial_swap_title">Saját betűkiosztás</string>
    <string name="tutorial_swap_text">„%1$s”: koppintson két billentyűre (vagy húzza egyiket a másikra), és helyet cserélnek. A QWERTY, AZERTY és más sablonok is megvannak.</string>
    <string name="tutorial_bind_title">Emoji hosszú nyomásra</string>
    <string name="tutorial_bind_text">„%1$s”: koppintson egy billentyűre, és adjon hozzá bármilyen emojit, betűt vagy saját szöveget – megjelenik, amikor lenyomva tartja a billentyűt.</string>
    <string name="tutorial_themes_title">Témák és háttér</string>
    <string name="tutorial_themes_text">„%1$s”: világos, sötét, átlátszó vagy animált RGB. „%2$s”: színezze ki a billentyűzet minden részét.</string>
    <string name="tutorial_features_title">Mit tehet még</string>
    <string name="tutorial_help_note">Szeretné újra látni? „%1$s” (?) → legalul.</string>
