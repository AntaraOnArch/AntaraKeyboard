    <string name="help_enable">Zapne klávesnicu Antara v zozname klávesníc Androidu. Stačí raz po inštalácii.</string>
    <string name="help_choose">Nastaví Antaru ako klávesnicu, ktorou píšete. Klávesnicu môžete prepnúť aj ikonou klávesnice na navigačnom paneli.</string>
    <string name="help_key_shape">Klávesy v tvare šesťuholníka, trojuholníka, kruhu alebo kocky. Ukážka nižšie zobrazuje zvolený tvar.</string>
    <string name="help_rows">3, 4 alebo 5 radov kláves. Rozloženia, bočné tlačidlá a znaky dlhého stlačenia sa riadia počtom radov.</string>
    <string name="help_key_height">Zvýši alebo zníži klávesy. Mení sa len výška, nikdy šírka ani medzery medzi klávesmi.</string>
    <string name="help_row_spacing">Pridá alebo uberie miesto medzi radmi kláves. Nič iné sa nemení.</string>
    <string name="help_side_offsets">Posunie bočné tlačidlá trochu doľava alebo doprava, napr. od zaobleného okraja displeja, zvlášť pre výšku a šírku.</string>
    <string name="help_layout_keys">Vyberte predvoľbu (QWERTZ, QWERTY, AZERTY, Dvorak…) alebo si písmená rozmiestnite sami: ťuknite na dve klávesy alebo presuňte jednu na druhú a vymeníte ich. Nižšie je číselné rozloženie; 0–9, ABC a Enter sa dajú len presúvať.</string>
    <string name="help_layout_side">Tlačidlá pri okrajoch displeja. Ťuknutím tlačidlu priradíte akciu (Shift, Backspace, Enter, medzera, znak alebo emoji), presunutím zmeníte poradie.</string>
    <string name="help_layout_horizontal">Symboly medzi oboma polovicami klávesnice na šírku. Každý sa dá zmeniť alebo nechať prázdny.</string>
    <string name="help_layout_emoji">Kde sa zobrazujú kategórie emoji a poradie a strana tlačidiel na zatvorenie, mazanie a medzeru.</string>
    <string name="help_saved_layouts">Vaše uložené rozloženia a zálohy vytvorené obnovením a importom. Ukážka, obnovenie rozloženia a/alebo farieb, premenovanie alebo odstránenie.</string>
    <string name="help_lp_alphabet">Podržaním písmena sa zobrazia ďalšie znaky. Ťuknutím na kláves mu sem pridáte špeciálne písmená, symboly alebo emoji.</string>
    <string name="help_lp_numeric">To isté pre klávesy číselného rozloženia.</string>
    <string name="help_lp_my_binds">Všetky klávesy so znakmi dlhého stlačenia v jednom zozname. Ťuknutím kláves upravíte.</string>
    <string name="help_lp_custom">Priradí dlhému stlačeniu klávesu ľubovoľný text, napr. vašu e-mailovú adresu alebo celú správu. Napíše sa presne tak, ako je zadaný.</string>
    <string name="help_colors_space">Farba medzerníkov: farba motívu, oba rovnako, alebo každý svoju.</string>
    <string name="help_colors_enter">Farba pozadia a ikony klávesu Enter. Používa ich aj vybraný znak v okne dlhého stlačenia.</string>
    <string name="help_colors_side">Farba ikon a pozadia bočných tlačidiel, alebo žiadne pozadie.</string>
    <string name="help_colors_keys">Jedna farba pre všetky klávesy, alebo ťuknite na kláves a dajte mu vlastnú farbu.</string>
    <string name="help_colors_background">Pozadie klávesnice: podľa motívu, tmavé, svetlé alebo vlastná farba.</string>
    <string name="help_colors_theme_defaults">Farby svetlého a tmavého motívu, ktoré sa použijú všade, kde sú zapnuté farby motívu.</string>
    <string name="help_language">Jazyk aplikácie a písmen klávesnice (latinka, cyrilika alebo gréčtina). Na klávesnici ho zmeníte podržaním oboch medzerníkov na 4 sekundy.</string>
    <string name="help_theme">Svetlý alebo tmavý, priehľadné pozadie, Vlastný (vaše uložené rozloženia) alebo animované RGB Smooth a RGB Wild.</string>
    <string name="help_rgb">Rýchlosť, sýtosť a jas animácie RGB.</string>
    <string name="help_vibration">Krátka vibrácia pri každom stlačení klávesu.</string>
    <string name="help_suggestions">Až tri slová nad klávesmi; ťuknutím slovo použijete. Žiadne automatické opravy a nič napísané sa neukladá.</string>
    <string name="help_reset">Farby, rozloženie alebo oboje na predvolené. Aktuálny stav sa najprv uloží do Uložených rozložení; znaky dlhého stlačenia a tvar kláves zostanú.</string>
    <string name="help_export">Uloží všetky nastavenia do súboru, napr. na prenos do nového telefónu. Nedávne emoji nie sú zahrnuté.</string>
    <string name="help_import">Načíta nastavenia z exportovaného súboru. Aktuálne nastavenia zostanú ako záloha v Uložených rozloženiach.</string>
    <string name="help_about">Verzia, súkromie a licencie open source.</string>
    <string name="help_q_capitals">Veľké písmená</string>
    <string name="help_capitals">Potiahnite nahor po písmene pre jedno veľké písmeno. Shift nechá veľké písmená zapnuté, kým naň znova neťuknete.</string>
    <string name="help_q_delete">Mazanie a obnovenie textu</string>
    <string name="help_delete">Potiahnutím doľava po klávesoch alebo priestore okolo nich mažete, doprava text vrátite. Čím dlhší ťah, tým rýchlejšie. Mazať sa dá aj podržaním klávesu Backspace.</string>
    <string name="help_q_special">Špeciálne znaky</string>
    <string name="help_special">Podržte kláves, potiahnite na znak a zdvihnite prst.</string>
    <string name="help_q_punctuation">Čiarka a výkričník</string>
    <string name="help_punctuation">Potiahnite nahor po . pre čiarku a po ? pre výkričník.</string>
    <string name="help_q_emoji">Emoji</string>
    <string name="help_emoji">Ťuknite na 😊 alebo potiahnite nahor po 123 (pri 4 a 5 radoch).</string>
    <string name="about_version">Verzia %1$s</string>
    <string name="about_privacy">Klávesnica Antara nemá prístup na internet a nič nezhromažďuje. Všetko, čo napíšete, a všetky nastavenia zostávajú vo vašom zariadení, pokiaľ ich sami neexportujete.</string>
    <string name="about_licenses">Licencie open source</string>
    <string name="about_licenses_hint">Ťuknutím na položku zobrazíte licenciu.</string>
