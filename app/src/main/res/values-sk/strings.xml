    <string name="help_title">Pomocník</string>
    <string name="help_hint">Ťuknutím na otázku zobrazíte odpoveď. Tlačidlo „Otvoriť“ pod ňou vás prenesie priamo na dané nastavenie.</string>
    <string name="help_go">Otvoriť</string>
