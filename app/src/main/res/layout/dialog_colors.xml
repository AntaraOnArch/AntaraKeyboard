<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Colors"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnScrollLeft"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="◀"
            android:textSize="12sp"
            android:padding="0dp"/>

        <HorizontalScrollView
            android:id="@+id/colorsScrollView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSpaceColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Space"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnEnterColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnSideButtonsColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Side"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnKeysColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keys"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnBackgroundColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BG"/>

            </LinearLayout>
        </HorizontalScrollView>

        <Button
            android:id="@+id/btnScrollRight"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="▶"
            android:textSize="12sp"
            android:padding="0dp"/>

    </LinearLayout>

</LinearLayout>