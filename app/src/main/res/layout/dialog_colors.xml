<?xml version="1.0" encoding="utf-8"?>
<!-- Colors popup: same structure as dialog_longpress_editor (section dropdown + autosaving page) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/main_app_bg">

    <!-- Section dropdown -->
    <Spinner
        android:id="@+id/spinnerColorsSection"
        style="@style/MainSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Scrolls only when the screen is too short -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:id="@+id/colorsPageContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>
