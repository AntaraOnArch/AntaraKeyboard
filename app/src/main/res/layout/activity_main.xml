<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/main_app_bg"
    tools:ignore="Overdraw">
    <!-- The window background is the keyboard color (keyboard_bg), so the screen paints its own -->

    <LinearLayout
        android:id="@+id/mainRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TITLE, help button at its end (the title stays centered on the screen) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingStart="56dp"
                android:paddingTop="12dp"
                android:paddingEnd="56dp"
                android:paddingBottom="12dp"
                android:text="@string/app_name"
                android:textSize="28sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnHelp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/main_icon_button"
                android:contentDescription="@string/help_title"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_help" />
        </FrameLayout>

        <!-- Enable + Choose -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEnableKeyboard"
                style="@style/MainRoundedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/main_enable"
                app:textAllCaps="false" />

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnChooseKeyboard"
                style="@style/MainRoundedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/main_choose"
                app:textAllCaps="false" />
        </LinearLayout>

        <!-- SET LAYOUT - full width -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSetLayout"
            style="@style/MainRoundedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/main_set_layout"
            app:textAllCaps="false" />

        <!-- Saved layouts (whenever there is a saved layout or "Last custom colors") -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSavedLayouts"
            style="@style/MainRoundedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/theme_btn_saved_layouts"
            android:visibility="gone"
            app:textAllCaps="false" />

        <!-- Key shape and row count side by side -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvKeyShape"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_key_shape"
                    android:textSize="18sp" />

                <Spinner
                    android:id="@+id/spinnerKeyShape"
                    android:saveEnabled="false"
                    style="@style/MainSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRowCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_keyboard_rows"
                    android:textSize="18sp" />

                <Spinner
                    android:id="@+id/spinnerRowCount"
                    android:saveEnabled="false"
                    style="@style/MainSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>

        <com.example.antarakeyboard.ui.ShapePreviewView
            android:id="@+id/preview"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="5dp"/>

        <!-- Classic + numbers only: show / hide the number row -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchNumberRow"
            android:saveEnabled="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/main_number_row"
            android:textSize="18sp"
            android:visibility="gone" />

        <!-- Key height (keyboard height follows) -->
        <TextView
            android:id="@+id/tvKeySize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textSize="18sp" />

        <SeekBar
            android:id="@+id/seekKeySize"
            android:saveEnabled="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- Vertical space between rows -->
        <TextView
            android:id="@+id/tvRowSpacing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textSize="18sp" />

        <SeekBar
            android:id="@+id/seekRowSpacing"
            android:saveEnabled="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- Bind + Reset -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/bindLPButton"
                style="@style/MainRoundedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/main_bind_long_press"
                app:textAllCaps="false" />

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <Spinner
                android:id="@+id/spinnerReset"
                android:saveEnabled="false"
                style="@style/MainSpinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Settings export / import (JSON file) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnExportSettings"
                style="@style/MainRoundedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/main_export"
                app:textAllCaps="false" />

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnImportSettings"
                style="@style/MainRoundedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/main_import"
                app:textAllCaps="false" />
        </LinearLayout>

        <!-- Side button positions and Colors popups side by side; a long label takes two
             lines. The first button wraps its content and the second matches its height
             (both match_parent would collapse the row to zero height) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSideOffsets"
                style="@style/MainRoundedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/main_side_offsets"
                app:textAllCaps="false" />

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnColors"
                style="@style/MainRoundedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/main_colors"
                app:textAllCaps="false" />
        </LinearLayout>

        <!-- App language and theme side by side -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_language"
                    android:textSize="18sp" />

                <Spinner
                    android:id="@+id/spinnerLanguage"
                    android:saveEnabled="false"
                    style="@style/MainSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTheme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_theme"
                    android:textSize="18sp" />

                <com.example.antarakeyboard.ui.ReselectSpinner
                    android:id="@+id/spinnerTheme"
                    android:saveEnabled="false"
                    style="@style/MainSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- RGB settings (only while an RGB theme is active) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnThemeSettings"
            style="@style/MainRoundedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/theme_btn_rgb_settings"
            android:visibility="gone"
            app:textAllCaps="false" />

        <!-- Vibration, word suggestions and double space → period: on / off switches -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchVibration"
            android:saveEnabled="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:minHeight="48dp"
            android:text="@string/main_vibration"
            android:textSize="18sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchSuggestions"
            android:saveEnabled="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/main_suggestions"
            android:textSize="18sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchDoubleSpacePeriod"
            android:saveEnabled="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/main_double_space_period"
            android:textSize="18sp" />

        <!-- About & open-source licenses -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAbout"
            style="@style/MainRoundedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/main_about"
            app:textAllCaps="false" />

    </LinearLayout>
</ScrollView>