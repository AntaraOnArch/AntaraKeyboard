<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/main_app_bg">

    <LinearLayout
        android:id="@+id/mainRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- NASLOV -->
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="Antara Keyboard"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Enable + Choose -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEnableKeyboard"
                style="@style/MainRoundedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Enable"
                app:textAllCaps="false" />

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnChooseKeyboard"
                style="@style/MainRoundedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Choose"
                app:textAllCaps="false" />
        </LinearLayout>

        <!-- SET LAYOUT - full width -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSetLayout"
            style="@style/MainRoundedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Set Layout"
            app:textAllCaps="false" />

        <!-- Key shape -->
        <TextView
            android:id="@+id/tvKeyShape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Key shape"
            android:textSize="18sp" />

        <Spinner
            android:id="@+id/spinnerKeyShape"
            style="@style/MainSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <com.example.antarakeyboard.ui.ShapePreviewView
            android:id="@+id/preview"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="5dp"/>

        <TextView
            android:id="@+id/tvRowCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Keyboard rows"
            android:textSize="18sp" />

        <Spinner
            android:id="@+id/spinnerRowCount"
            style="@style/MainSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- Bind + Reset -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/bindLPButton"
                style="@style/MainRoundedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bind LongPress"
                app:textAllCaps="false" />

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/resetLayoutButton"
                style="@style/MainRoundedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reset Layout"
                app:textAllCaps="false" />
        </LinearLayout>

        <!-- Colors dropdown -->
        <TextView
            android:id="@+id/tvColors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Colors"
            android:textSize="18sp" />

        <Spinner
            android:id="@+id/spinnerColors"
            style="@style/MainSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- Vibration toggle -->
        <TextView
            android:id="@+id/tvVibration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Vibration feedback"
            android:textSize="18sp" />

        <Spinner
            android:id="@+id/spinnerVibration"
            style="@style/MainSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- Theme dropdown -->
        <TextView
            android:id="@+id/tvTheme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Theme"
            android:textSize="18sp" />

        <Spinner
            android:id="@+id/spinnerTheme"
            style="@style/MainSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>