<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/main_app_bg">

    <LinearLayout
        android:id="@+id/mainRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- NASLOV -->
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Enable + Choose -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEnableKeyboard"
                style="@style/MainRoundedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/main_enable"
                app:textAllCaps="false" />

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnChooseKeyboard"
                style="@style/MainRoundedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/main_choose"
                app:textAllCaps="false" />
        </LinearLayout>

        <!-- SET LAYOUT - full width -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSetLayout"
            style="@style/MainRoundedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/main_set_layout"
            app:textAllCaps="false" />

        <!-- Key shape -->
        <TextView
            android:id="@+id/tvKeyShape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/main_key_shape"
            android:textSize="18sp" />

        <Spinner
            android:id="@+id/spinnerKeyShape"
            style="@style/MainSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <com.example.antarakeyboard.ui.ShapePreviewView
            android:id="@+id/preview"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="5dp"/>

        <TextView
            android:id="@+id/tvRowCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/main_keyboard_rows"
            android:textSize="18sp" />

        <Spinner
            android:id="@+id/spinnerRowCount"
            style="@style/MainSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- Key height (keyboard height follows) -->
        <TextView
            android:id="@+id/tvKeySize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textSize="18sp" />

        <SeekBar
            android:id="@+id/seekKeySize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- Vertical space between rows -->
        <TextView
            android:id="@+id/tvRowSpacing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textSize="18sp" />

        <SeekBar
            android:id="@+id/seekRowSpacing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- Bind + Reset -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/bindLPButton"
                style="@style/MainRoundedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/main_bind_long_press"
                app:textAllCaps="false" />

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <Spinner
                android:id="@+id/spinnerReset"
                style="@style/MainSpinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Settings export / import (JSON file) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnExportSettings"
                style="@style/MainRoundedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/main_export"
                app:textAllCaps="false" />

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnImportSettings"
                style="@style/MainRoundedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/main_import"
                app:textAllCaps="false" />
        </LinearLayout>

        <!-- Colors popup -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnColors"
            style="@style/MainRoundedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/main_colors"
            app:textAllCaps="false" />

        <!-- Vibration toggle -->
        <TextView
            android:id="@+id/tvVibration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/main_vibration"
            android:textSize="18sp" />

        <Spinner
            android:id="@+id/spinnerVibration"
            style="@style/MainSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- App language -->
        <TextView
            android:id="@+id/tvLanguage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/main_language"
            android:textSize="18sp" />

        <Spinner
            android:id="@+id/spinnerLanguage"
            style="@style/MainSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- Theme dropdown -->
        <TextView
            android:id="@+id/tvTheme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/main_theme"
            android:textSize="18sp" />

        <com.example.antarakeyboard.ui.ReselectSpinner
            android:id="@+id/spinnerTheme"
            style="@style/MainSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- Shown only while an RGB or Custom theme is active -->
        <Button
            android:id="@+id/btnThemeSettings"
            style="@style/MainRoundedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:textAllCaps="false" />

    </LinearLayout>
</ScrollView>