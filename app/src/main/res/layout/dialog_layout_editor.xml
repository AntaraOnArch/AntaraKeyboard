<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/main_app_bg">

    <!-- Section dropdown -->
    <Spinner
        android:id="@+id/spinnerSection"
        style="@style/MainSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:id="@+id/pageLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLayoutTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/layout_section_alphabet"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <FrameLayout
                android:id="@+id/layoutEditorContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pageSideButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSideButtonsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/layout_section_side"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <FrameLayout
                android:id="@+id/sideButtonsEditorContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pageNumeric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvNumericTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/layout_section_numeric"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <FrameLayout
                android:id="@+id/numericEditorContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pageHorizontalCenter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvHorizontalTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/layout_section_horizontal"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <FrameLayout
                android:id="@+id/horizontalEditorContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/pageEmojiPicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/emojiPickerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <!-- Saved layouts dropdown -->
        <LinearLayout
            android:id="@+id/savedLayoutsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/saved_layouts_label"
                android:textSize="14sp"
                android:paddingEnd="8dp" />

            <Spinner
                android:id="@+id/spinnerSavedLayouts"
                style="@style/MainSpinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSwapSelected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/swap_selected"
            android:textAllCaps="false" />
    </LinearLayout>

</LinearLayout>
