    <string name="help_enable">Uključuje Antara tastaturu na Androidovoj listi tastatura. Potrebno jednom nakon instalacije.</string>
    <string name="help_choose">Postavlja Antaru kao tastaturu kojom kucate. Tastaturu možete promijeniti i ikonom tastature na navigacijskoj traci.</string>
    <string name="help_key_shape">Tipke u obliku šestougla, trougla, kruga ili kocke. Pregled ispod prikazuje odabrani oblik.</string>
    <string name="help_rows">3, 4 ili 5 redova tipki. Rasporedi, bočna dugmad i znakovi dugog pritiska prate broj redova.</string>
    <string name="help_key_height">Tipke postaju više ili niže. Mijenja se samo visina, nikad širina ni razmaci između tipki.</string>
    <string name="help_row_spacing">Dodaje ili smanjuje razmak između redova tipki. Ništa drugo se ne mijenja.</string>
    <string name="help_side_offsets">Pomjera bočnu dugmad malo lijevo ili desno, npr. dalje od zaobljene ivice ekrana, posebno za uspravni i položeni prikaz.</string>
    <string name="help_layout_keys">Odaberite šablon (QWERTZ, QWERTY, AZERTY, Dvorak…) ili sami složite slova: dodirnite dvije tipke ili prevucite jednu na drugu da ih zamijenite. Ispod je numerički raspored; 0–9, ABC i Enter mogu se samo pomjerati.</string>
    <string name="help_layout_side">Dugmad na ivicama ekrana. Dodirnite jedno da mu dodijelite radnju (Shift, Backspace, Enter, razmak, znak ili emoji), prevucite ih da promijenite redoslijed.</string>
    <string name="help_layout_horizontal">Simboli između dvije polovine tastature u položenom prikazu. Svaki se može promijeniti ili ostaviti prazan.</string>
    <string name="help_layout_emoji">Gdje se prikazuju kategorije emojija te redoslijed i strana dugmadi za zatvaranje, brisanje i razmak.</string>
    <string name="help_saved_layouts">Vaši sačuvani rasporedi i rezervne kopije nastale resetovanjem i uvozom. Pregledajte, vratite raspored i/ili boje, preimenujte ili izbrišite.</string>
    <string name="help_lp_alphabet">Držanje slova prikazuje dodatne znakove. Ovdje dodirnite tipku da joj dodate posebna slova, simbole ili emojije.</string>
    <string name="help_lp_numeric">Isto za tipke numeričkog rasporeda.</string>
    <string name="help_lp_my_binds">Sve tipke koje imaju znakove dugog pritiska, na jednoj listi. Dodirnite jednu da je promijenite.</string>
    <string name="help_lp_custom">Stavlja bilo koji tekst na dugi pritisak tipke, npr. vašu e-mail adresu ili cijelu poruku. Upisuje se tačno kako je napisan.</string>
    <string name="help_colors_space">Boja razmaknica: boja teme, obje iste ili svaka svoja.</string>
    <string name="help_colors_enter">Boja pozadine i ikone tipke Enter. Koristi ih i odabrani znak u iskačućem prozoru dugog pritiska.</string>
    <string name="help_colors_side">Boja ikone i pozadine bočne dugmadi ili bez pozadine.</string>
    <string name="help_colors_keys">Jedna boja za sve tipke ili dodirnite tipku da joj date vlastitu boju.</string>
    <string name="help_colors_background">Pozadina tastature: prema temi, tamna, svijetla ili vaša boja.</string>
    <string name="help_colors_theme_defaults">Boje koje svijetla i tamna tema koriste gdje god su uključene boje teme.</string>
    <string name="help_language">Jezik aplikacije i slova tastature (latinica, ćirilica ili grčki). Na tastaturi ga promijenite držanjem obje razmaknice 4 sekunde.</string>
    <string name="help_theme">Svijetla ili tamna, prozirna pozadina, Prilagođena (vaši sačuvani rasporedi) ili animirane RGB Smooth i RGB Wild.</string>
    <string name="help_rgb">Brzina, zasićenost i svjetlina RGB animacije.</string>
    <string name="help_vibration">Kratka vibracija pri svakom pritisku tipke.</string>
    <string name="help_suggestions">Do tri riječi iznad tipki; dodirnite jednu da je upotrijebite. Nema autokorekcije i ništa što kucate se ne sprema.</string>
    <string name="help_reset">Boje, raspored ili oboje na zadano. Trenutno stanje se prvo sprema u Sačuvane rasporede; znakovi dugog pritiska i oblik tipki ostaju.</string>
    <string name="help_export">Sprema sve postavke u datoteku, npr. za prenos na novi telefon. Nedavni emojiji nisu uključeni.</string>
    <string name="help_import">Učitava postavke iz izvezene datoteke. Trenutne postavke ostaju kao rezervna kopija u Sačuvanim rasporedima.</string>
    <string name="help_about">Verzija, privatnost i licence otvorenog koda.</string>
    <string name="help_q_capitals">Velika slova</string>
    <string name="help_capitals">Prevucite prema gore po slovu za jedno veliko slovo. Shift drži velika slova uključena dok ga ponovo ne dodirnete.</string>
    <string name="help_q_delete">Brisanje i vraćanje teksta</string>
    <string name="help_delete">Prevucite ulijevo po tipkama ili prostoru oko njih za brisanje, udesno za vraćanje teksta. Što duže prevlačite, to brže. Držanje tipke za brisanje također briše.</string>
    <string name="help_q_special">Posebni znakovi</string>
    <string name="help_special">Držite tipku, kliznite do znaka i podignite prst.</string>
    <string name="help_q_punctuation">Zarez i uzvičnik</string>
    <string name="help_punctuation">Prevucite prema gore po . za zarez i po ? za uzvičnik.</string>
    <string name="help_q_emoji">Emojiji</string>
    <string name="help_emoji">Dodirnite 😊 ili prevucite prema gore po 123 (s 4 i 5 redova).</string>
    <string name="about_version">Verzija %1$s</string>
    <string name="about_privacy">Antara tastatura nema pristup internetu i ništa ne prikuplja. Sve što kucate i sve postavke ostaju na vašem uređaju, osim ako ih sami ne izvezete.</string>
