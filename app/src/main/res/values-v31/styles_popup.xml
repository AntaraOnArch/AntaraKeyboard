<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same as values/styles_popup.xml plus a blur of the screen behind the popup -->
    <style name="AntaraPopup" parent="ThemeOverlay.Material3.Dialog">
        <item name="android:windowBackground">@drawable/popup_frame</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowBlurBehindEnabled">true</item>
        <item name="android:windowBlurBehindRadius">12dp</item>
    </style>

    <style name="AntaraAlertPopup" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="android:windowBackground">@drawable/popup_frame</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowBlurBehindEnabled">true</item>
        <item name="android:windowBlurBehindRadius">12dp</item>
    </style>
</resources>
