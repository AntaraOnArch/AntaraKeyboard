    <string name="tutorial_enable_title">Turn the keyboard on</string>
    <string name="tutorial_enable_text">Tap “%1$s”, switch Antara on in the list and come back here.</string>
    <string name="tutorial_choose_title">Make it your keyboard</string>
    <string name="tutorial_choose_text">Tap “%1$s” and pick Antara.</string>
    <string name="tutorial_input_hint">Practice here</string>
    <string name="tutorial_not_active">Antara is not your active keyboard yet – the practice needs it.</string>
    <string name="tutorial_capitals_text">Swipe up on a letter to type it as a capital. Type two capitals.</string>
    <string name="tutorial_caps_title">Only capitals</string>
    <string name="tutorial_caps_text">Shift (⇧) is really caps lock: tap it once and every letter is a capital until you tap it again. Type any 5 capitals – with Shift or by swiping up, it doesn\'t matter which.</string>
    <string name="tutorial_punctuation_text">Swipe up on . for a comma and on ? for an exclamation mark. Type both.</string>
    <string name="tutorial_delete_title">Delete with a swipe</string>
    <string name="tutorial_delete_text">Swipe left on the keys or the space around them – the longer the swipe, the faster it deletes.</string>
    <string name="tutorial_restore_title">Bring the text back</string>
    <string name="tutorial_restore_text">Type one letter or symbol, swipe left to delete it and swipe right to bring it back. Do it 3 times.</string>
    <string name="tutorial_long_press_text">Hold a key, slide to a special letter and lift your finger. Type one special letter.</string>
    <string name="tutorial_long_press_example">Special letters of your language – hold any of these keys:\n%1$s</string>
    <string name="tutorial_emoji_text">Swipe up on 123 (or tap 😊) and pick an emoji.</string>
    <string name="tutorial_rounds" translatable="false">%1$d / %2$d</string>
    <string name="tutorial_sample_text">Antara</string>
    <string name="tutorial_swap_title">Your own letter layout</string>
    <string name="tutorial_swap_text">“%1$s”: tap two keys (or drag one onto the other) and they swap places. QWERTY, AZERTY and other presets are there too.</string>
    <string name="tutorial_bind_title">Emoji on long press</string>
    <string name="tutorial_bind_text">“%1$s”: tap a key and add any emoji, letter or your own text – it appears when you hold that key.</string>
    <string name="tutorial_themes_title">Themes and background</string>
    <string name="tutorial_themes_text">“%1$s”: Light, Dark, Transparent or animated RGB. “%2$s”: color every part of the keyboard.</string>
    <string name="tutorial_features_title">More you can do</string>
    <string name="tutorial_help_note">Want to see this again? “%1$s” (?) → at the very bottom.</string>
    <string name="help_group_keyboard">Keyboard</string>
    <string name="help_group_app">App</string>
    <string name="help_group_gestures">Gestures on the keyboard</string>
    <string name="help_enable">Turns Antara Keyboard on in Android\'s list of keyboards. Needed once after installing.</string>
    <string name="help_choose">Makes Antara the keyboard you type with. You can also switch keyboards from the keyboard icon in the navigation bar.</string>
    <string name="help_key_shape">Hexagon, triangle, circle or cube keys. The preview below shows the selected shape. Classic and Classic + numbers are a phone-style keyboard with a fixed 4 or 5 rows.</string>
    <string name="help_rows">3, 4 or 5 rows of keys. Layouts, side buttons and long-press characters follow the row count.</string>
    <string name="help_key_height">Makes the keys taller or shorter. Only the height changes, never the width or the gaps between keys.</string>
    <string name="help_row_spacing">Adds or removes space between the rows of keys. Nothing else changes.</string>
    <string name="help_side_offsets">Moves the side buttons a little left or right, e.g. away from a rounded screen edge, separately for portrait and landscape.</string>
    <string name="help_layout_keys">Choose a preset (QWERTZ, QWERTY, AZERTY, Dvorak…) or arrange the letters yourself: tap two keys or drag one onto another to swap them. The numeric layout is below; 0–9, ABC and Enter can only be moved.</string>
    <string name="help_layout_side">The buttons at the screen edges. Tap one to give it an action (Shift, Backspace, Enter, Space, a character or the emoji picker), drag them to change the order.</string>
    <string name="help_layout_horizontal">The symbols between the two halves of the keyboard in landscape. Any of them can be changed or left empty.</string>
    <string name="help_layout_emoji">Where the emoji categories are shown, and the order and side of the close, backspace and space buttons.</string>
    <string name="help_saved_layouts">Your saved layouts and the backups made by Reset and Import. Preview one, restore its layout and/or colors, rename or delete it.</string>
    <string name="help_lp_alphabet">Holding a letter shows extra characters. Tap a key here to add special letters, symbols or emoji to it.</string>
    <string name="help_lp_numeric">The same for the keys of the numeric layout.</string>
    <string name="help_lp_my_binds">All keys that have long-press characters, in one list. Tap one to change it.</string>
    <string name="help_lp_custom">Puts any text on a key\'s long press, e.g. your e-mail address or a whole message. It is typed exactly as written.</string>
    <string name="help_colors_space">The color of the space keys: the theme color, both the same, or each one its own.</string>
    <string name="help_colors_enter">Background and icon color of Enter. The selected character in the long-press popup uses them too.</string>
    <string name="help_colors_side">Icon and background color of the side buttons, or no background at all.</string>
    <string name="help_colors_keys">One color for all keys, or tap a key to give it its own color.</string>
    <string name="help_colors_background">Keyboard background: by theme, dark, light or a color of your own.</string>
    <string name="help_colors_theme_defaults">The colors the Light and Dark themes use wherever theme colors are on.</string>
    <string name="help_language">Language of the app and of the keyboard\'s letters (Latin, Cyrillic or Greek). On the keyboard, hold both space keys for 4 seconds to change it. With a classic shape, hold the space key.</string>
    <string name="help_theme">Light or Dark, a transparent background, Custom (your saved layouts) or the animated RGB Smooth and RGB Wild.</string>
    <string name="help_rgb">Speed, saturation and brightness of the RGB animation.</string>
    <string name="help_vibration">A short vibration on every key press.</string>
    <string name="help_suggestions">Up to three words above the keys; tap one to use it. No autocorrect, and nothing you type is stored.</string>
    <string name="help_double_space_period">Two spaces after a word type a period and a space. Not in passwords, e-mail addresses or links.</string>
    <string name="help_number_row">Classic + numbers only: shows or hides the row of numbers above the letters.</string>
    <string name="help_reset">Colors, layout or both back to default. The current state is saved in Saved layouts first; long-press characters and the key shape stay.</string>
    <string name="help_export">Saves all settings to a file, e.g. to move them to a new phone. Recent emojis are not included.</string>
    <string name="help_import">Loads settings from an exported file. Your current settings are kept as a backup in Saved layouts.</string>
    <string name="help_about">Version, privacy and the open-source licenses.</string>
    <string name="help_q_capitals">Capital letters</string>
    <string name="help_capitals">Swipe up on a letter for one capital. Shift keeps capitals on until you tap it again.</string>
    <string name="help_q_delete">Delete and restore text</string>
    <string name="help_delete">Swipe left on the keys or the space around them to delete, swipe right to bring the text back. The longer the swipe, the faster. Holding backspace deletes too.</string>
    <string name="help_q_special">Special characters</string>
    <string name="help_special">Hold a key, slide to a character and lift your finger.</string>
    <string name="help_q_punctuation">Comma and exclamation mark</string>
    <string name="help_punctuation">Swipe up on . for a comma and on ? for an exclamation mark.</string>
    <string name="help_q_emoji">Emoji</string>
    <string name="help_emoji">Tap 😊 or swipe up on 123 (with 4 and 5 rows).</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_privacy">Antara Keyboard has no internet access and collects nothing. Everything you type and all settings stay on your device, unless you export them yourself.</string>
    <string name="about_licenses">Open-source licenses</string>
    <string name="about_licenses_hint">Tap an entry to read its license.</string>
