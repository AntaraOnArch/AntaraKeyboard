    <string name="tutorial_enable_title">Uključite tipkovnicu</string>
    <string name="tutorial_enable_text">Dodirnite „%1$s“, uključite Antaru na popisu i vratite se ovamo.</string>
    <string name="tutorial_choose_title">Neka bude vaša tipkovnica</string>
    <string name="tutorial_choose_text">Dodirnite „%1$s“ i odaberite Antaru.</string>
    <string name="tutorial_input_hint">Vježbajte ovdje</string>
    <string name="tutorial_not_active">Antara još nije aktivna tipkovnica – vježba je treba.</string>
    <string name="tutorial_capitals_text">Povucite prema gore po slovu i upisat će se veliko. Upišite dva velika slova.</string>
    <string name="tutorial_caps_title">Samo velika slova</string>
    <string name="tutorial_caps_text">Shift (⇧) je zapravo caps lock: dodirnite ga jednom i svako slovo je veliko dok ga ponovno ne dodirnete. Upišite bilo kojih 5 velikih slova – Shiftom ili potezom prema gore, svejedno je.</string>
    <string name="tutorial_punctuation_text">Povucite prema gore po . za zarez i po ? za uskličnik. Upišite oba.</string>
    <string name="tutorial_delete_title">Brisanje potezom</string>
    <string name="tutorial_delete_text">Povucite ulijevo po tipkama ili prostoru oko njih – što je potez duži, brže briše.</string>
    <string name="tutorial_restore_title">Vratite tekst</string>
    <string name="tutorial_restore_text">Upišite jedno slovo ili znak, povucite ulijevo da ga obrišete i udesno da ga vratite. Ponovite 3 puta.</string>
    <string name="tutorial_long_press_text">Držite tipku, kliznite do posebnog slova i podignite prst. Upišite jedno posebno slovo.</string>
    <string name="tutorial_long_press_example">Posebna slova vašeg jezika – držite bilo koju od ovih tipki:\n%1$s</string>
    <string name="tutorial_emoji_text">Povucite prema gore po 123 (ili dodirnite 😊) i odaberite emoji.</string>
    <string name="tutorial_sample_text">Antara</string>
    <string name="tutorial_swap_title">Vlastiti raspored slova</string>
    <string name="tutorial_swap_text">„%1$s“: dodirnite dvije tipke (ili povucite jednu na drugu) i zamijene mjesta. Tu su i QWERTY, AZERTY i drugi rasporedi.</string>
    <string name="tutorial_bind_title">Emoji na dugi pritisak</string>
    <string name="tutorial_bind_text">„%1$s“: dodirnite tipku i dodajte bilo koji emoji, slovo ili vlastiti tekst – pojavi se kad držite tu tipku.</string>
    <string name="tutorial_themes_title">Teme i pozadina</string>
    <string name="tutorial_themes_text">„%1$s“: svijetla, tamna, prozirna ili animirana RGB. „%2$s“: obojite svaki dio tipkovnice.</string>
    <string name="tutorial_features_title">Što još možete</string>
    <string name="tutorial_help_note">Želite ovo opet vidjeti? „%1$s“ (?) → na samom dnu.</string>
    <string name="help_group_keyboard">Tipkovnica</string>
    <string name="help_group_app">Aplikacija</string>
    <string name="help_group_gestures">Geste na tipkovnici</string>
    <string name="help_enable">Uključuje Antara tipkovnicu na Androidovom popisu tipkovnica. Potrebno jednom nakon instalacije.</string>
    <string name="help_choose">Postavlja Antaru kao tipkovnicu kojom tipkate. Tipkovnicu možete promijeniti i ikonom tipkovnice na navigacijskoj traci.</string>
    <string name="help_key_shape">Tipke u obliku šesterokuta, trokuta, kruga ili kocke. Pregled ispod prikazuje odabrani oblik.</string>
    <string name="help_rows">3, 4 ili 5 redova tipki. Rasporedi, bočni gumbi i znakovi dugog pritiska prate broj redova.</string>
    <string name="help_key_height">Tipke postaju više ili niže. Mijenja se samo visina, nikad širina ni razmaci između tipki.</string>
    <string name="help_row_spacing">Dodaje ili smanjuje razmak između redova tipki. Ništa se drugo ne mijenja.</string>
    <string name="help_side_offsets">Pomiče bočne gumbe malo lijevo ili desno, npr. dalje od zaobljenog ruba zaslona, posebno za uspravni i položeni prikaz.</string>
    <string name="help_layout_keys">Odaberite predložak (QWERTZ, QWERTY, AZERTY, Dvorak…) ili sami složite slova: dodirnite dvije tipke ili povucite jednu na drugu da ih zamijenite. Ispod je numerički raspored; 0–9, ABC i Enter mogu se samo premještati.</string>
    <string name="help_layout_side">Gumbi na rubovima zaslona. Dodirnite jedan da mu dodijelite radnju (Shift, Backspace, Enter, razmak, znak ili emoji), povucite ih da promijenite redoslijed.</string>
    <string name="help_layout_horizontal">Simboli između dviju polovica tipkovnice u položenom prikazu. Svaki se može promijeniti ili ostaviti prazan.</string>
    <string name="help_layout_emoji">Gdje se prikazuju kategorije emojija te redoslijed i strana gumba za zatvaranje, brisanje i razmak.</string>
    <string name="help_saved_layouts">Vaši spremljeni rasporedi i sigurnosne kopije nastale resetiranjem i uvozom. Pregledajte, vratite raspored i/ili boje, preimenujte ili izbrišite.</string>
    <string name="help_lp_alphabet">Držanje slova prikazuje dodatne znakove. Ovdje dodirnite tipku da joj dodate posebna slova, simbole ili emojije.</string>
    <string name="help_lp_numeric">Isto za tipke numeričkog rasporeda.</string>
    <string name="help_lp_my_binds">Sve tipke koje imaju znakove dugog pritiska, na jednom popisu. Dodirnite jednu da je promijenite.</string>
    <string name="help_lp_custom">Stavlja bilo koji tekst na dugi pritisak tipke, npr. vašu e-mail adresu ili cijelu poruku. Upisuje se točno kako je napisan.</string>
    <string name="help_colors_space">Boja razmaknica: boja teme, obje iste ili svaka svoja.</string>
    <string name="help_colors_enter">Boja pozadine i ikone tipke Enter. Koristi ih i odabrani znak u skočnom prozoru dugog pritiska.</string>
    <string name="help_colors_side">Boja ikone i pozadine bočnih gumba ili bez pozadine.</string>
    <string name="help_colors_keys">Jedna boja za sve tipke ili dodirnite tipku da joj date vlastitu boju.</string>
    <string name="help_colors_background">Pozadina tipkovnice: prema temi, tamna, svijetla ili vaša boja.</string>
    <string name="help_colors_theme_defaults">Boje koje svijetla i tamna tema koriste gdje god su uključene boje teme.</string>
    <string name="help_language">Jezik aplikacije i slova tipkovnice (latinica, ćirilica ili grčki). Na tipkovnici ga promijenite držanjem obje razmaknice 4 sekunde.</string>
    <string name="help_theme">Svijetla ili tamna, prozirna pozadina, Prilagođena (vaši spremljeni rasporedi) ili animirane RGB Smooth i RGB Wild.</string>
    <string name="help_rgb">Brzina, zasićenost i svjetlina RGB animacije.</string>
    <string name="help_vibration">Kratka vibracija pri svakom pritisku tipke.</string>
    <string name="help_suggestions">Do tri riječi iznad tipki; dodirnite jednu da je upotrijebite. Nema autokorekcije i ništa što tipkate ne sprema se.</string>
    <string name="help_double_space_period">Dva razmaka nakon riječi upisuju točku i razmak. Ne u lozinkama, e-mail adresama ni poveznicama.</string>
    <string name="help_reset">Boje, raspored ili oboje na zadano. Trenutno stanje prvo se sprema u Spremljene rasporede; znakovi dugog pritiska i oblik tipki ostaju.</string>
    <string name="help_export">Sprema sve postavke u datoteku, npr. za prijenos na novi mobitel. Nedavni emojiji nisu uključeni.</string>
    <string name="help_import">Učitava postavke iz izvezene datoteke. Trenutne postavke ostaju kao sigurnosna kopija u Spremljenim rasporedima.</string>
    <string name="help_about">Verzija, privatnost i licence otvorenog koda.</string>
    <string name="help_q_capitals">Velika slova</string>
    <string name="help_capitals">Povucite prema gore po slovu za jedno veliko slovo. Shift drži velika slova uključena dok ga ponovno ne dodirnete.</string>
    <string name="help_q_delete">Brisanje i vraćanje teksta</string>
    <string name="help_delete">Povucite ulijevo po tipkama ili prostoru oko njih za brisanje, udesno za vraćanje teksta. Što dulje povlačite, to brže. Držanje tipke za brisanje također briše.</string>
    <string name="help_q_special">Posebni znakovi</string>
    <string name="help_special">Držite tipku, kliznite do znaka i podignite prst.</string>
    <string name="help_q_punctuation">Zarez i uskličnik</string>
    <string name="help_punctuation">Povucite prema gore po . za zarez i po ? za uskličnik.</string>
    <string name="help_q_emoji">Emojiji</string>
    <string name="help_emoji">Dodirnite 😊 ili povucite prema gore po 123 (s 4 i 5 redova).</string>
    <string name="about_version">Verzija %1$s</string>
    <string name="about_privacy">Antara tipkovnica nema pristup internetu i ništa ne prikuplja. Sve što tipkate i sve postavke ostaju na vašem uređaju, osim ako ih sami ne izvezete.</string>
