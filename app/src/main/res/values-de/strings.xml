    <string name="help_title">Hilfe</string>
    <string name="help_hint">Tippe auf eine Frage, um die Antwort zu sehen. „Öffnen“ darunter führt direkt zu dieser Einstellung.</string>
    <string name="help_go">Öffnen</string>
