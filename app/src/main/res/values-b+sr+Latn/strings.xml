    <string name="help_enable">Uključuje Antara tastaturu na Androidovoj listi tastatura. Potrebno jednom nakon instalacije.</string>
    <string name="help_choose">Postavlja Antaru kao tastaturu kojom kucate. Tastaturu možete promeniti i ikonom tastature na navigacionoj traci.</string>
    <string name="help_key_shape">Tasteri u obliku šestougla, trougla, kruga ili kocke. Pregled ispod prikazuje izabrani oblik.</string>
    <string name="help_rows">3, 4 ili 5 redova tastera. Rasporedi, bočni tasteri i znakovi dugog pritiska prate broj redova.</string>
    <string name="help_key_height">Tasteri postaju viši ili niži. Menja se samo visina, nikad širina ni razmaci između tastera.</string>
    <string name="help_row_spacing">Dodaje ili smanjuje razmak između redova tastera. Ništa drugo se ne menja.</string>
    <string name="help_side_offsets">Pomera bočne tastere malo levo ili desno, npr. dalje od zaobljene ivice ekrana, posebno za uspravni i položeni prikaz.</string>
    <string name="help_layout_keys">Izaberite šablon (QWERTZ, QWERTY, AZERTY, Dvorak…) ili sami složite slova: dodirnite dva tastera ili prevucite jedan na drugi da ih zamenite. Ispod je numerički raspored; 0–9, ABC i Enter mogu samo da se pomeraju.</string>
    <string name="help_layout_side">Tasteri na ivicama ekrana. Dodirnite jedan da mu dodelite radnju (Shift, Backspace, Enter, razmak, znak ili emodži), prevucite ih da promenite redosled.</string>
    <string name="help_layout_horizontal">Simboli između dve polovine tastature u položenom prikazu. Svaki može da se promeni ili ostavi prazan.</string>
    <string name="help_layout_emoji">Gde se prikazuju kategorije emodžija i redosled i strana tastera za zatvaranje, brisanje i razmak.</string>
    <string name="help_saved_layouts">Vaši sačuvani rasporedi i rezervne kopije nastale resetovanjem i uvozom. Pregledajte, vratite raspored i/ili boje, preimenujte ili izbrišite.</string>
    <string name="help_lp_alphabet">Držanje slova prikazuje dodatne znakove. Ovde dodirnite taster da mu dodate posebna slova, simbole ili emodžije.</string>
    <string name="help_lp_numeric">Isto za tastere numeričkog rasporeda.</string>
    <string name="help_lp_my_binds">Svi tasteri koji imaju znakove dugog pritiska, na jednoj listi. Dodirnite jedan da ga promenite.</string>
    <string name="help_lp_custom">Stavlja bilo koji tekst na dugi pritisak tastera, npr. vašu imejl adresu ili celu poruku. Unosi se tačno kako je napisan.</string>
    <string name="help_colors_space">Boja razmaknica: boja teme, obe iste ili svaka svoja.</string>
    <string name="help_colors_enter">Boja pozadine i ikone tastera Enter. Koristi ih i izabrani znak u iskačućem prozoru dugog pritiska.</string>
    <string name="help_colors_side">Boja ikone i pozadine bočnih tastera ili bez pozadine.</string>
    <string name="help_colors_keys">Jedna boja za sve tastere ili dodirnite taster da mu date sopstvenu boju.</string>
    <string name="help_colors_background">Pozadina tastature: prema temi, tamna, svetla ili vaša boja.</string>
    <string name="help_colors_theme_defaults">Boje koje svetla i tamna tema koriste gde god su uključene boje teme.</string>
    <string name="help_language">Jezik aplikacije i slova tastature (latinica, ćirilica ili grčki). Na tastaturi ga promenite držanjem obe razmaknice 4 sekunde.</string>
    <string name="help_theme">Svetla ili tamna, providna pozadina, Prilagođena (vaši sačuvani rasporedi) ili animirane RGB Smooth i RGB Wild.</string>
    <string name="help_rgb">Brzina, zasićenost i osvetljenost RGB animacije.</string>
    <string name="help_vibration">Kratka vibracija pri svakom pritisku tastera.</string>
    <string name="help_suggestions">Do tri reči iznad tastera; dodirnite jednu da je upotrebite. Nema autokorekcije i ništa što kucate se ne čuva.</string>
    <string name="help_reset">Boje, raspored ili oboje na podrazumevano. Trenutno stanje se prvo čuva u Sačuvanim rasporedima; znakovi dugog pritiska i oblik tastera ostaju.</string>
    <string name="help_export">Čuva sva podešavanja u datoteku, npr. za prenos na novi telefon. Nedavni emodžiji nisu uključeni.</string>
    <string name="help_import">Učitava podešavanja iz izvezene datoteke. Trenutna podešavanja ostaju kao rezervna kopija u Sačuvanim rasporedima.</string>
    <string name="help_about">Verzija, privatnost i licence otvorenog koda.</string>
    <string name="help_q_capitals">Velika slova</string>
    <string name="help_capitals">Prevucite nagore po slovu za jedno veliko slovo. Shift drži velika slova uključena dok ga ponovo ne dodirnete.</string>
    <string name="help_q_delete">Brisanje i vraćanje teksta</string>
    <string name="help_delete">Prevucite ulevo po tasterima ili prostoru oko njih za brisanje, udesno za vraćanje teksta. Što duže prevlačite, to brže. Držanje tastera za brisanje takođe briše.</string>
    <string name="help_q_special">Posebni znakovi</string>
    <string name="help_special">Držite taster, kliznite do znaka i podignite prst.</string>
    <string name="help_q_punctuation">Zarez i uzvičnik</string>
    <string name="help_punctuation">Prevucite nagore po . za zarez i po ? za uzvičnik.</string>
    <string name="help_q_emoji">Emodžiji</string>
    <string name="help_emoji">Dodirnite 😊 ili prevucite nagore po 123 (sa 4 i 5 redova).</string>
    <string name="about_version">Verzija %1$s</string>
    <string name="about_privacy">Antara tastatura nema pristup internetu i ništa ne prikuplja. Sve što kucate i sva podešavanja ostaju na vašem uređaju, osim ako ih sami ne izvezete.</string>
