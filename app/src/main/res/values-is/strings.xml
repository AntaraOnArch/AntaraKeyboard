    <string name="tutorial_enable_title">Kveiktu á lyklaborðinu</string>
    <string name="tutorial_enable_text">Ýttu á „%1$s“, kveiktu á Antara í listanum og komdu aftur hingað.</string>
    <string name="tutorial_choose_title">Gerðu það að þínu lyklaborði</string>
    <string name="tutorial_choose_text">Ýttu á „%1$s“ og veldu Antara.</string>
    <string name="tutorial_input_hint">Æfðu þig hér</string>
    <string name="tutorial_not_active">Antara er ekki enn virka lyklaborðið – æfingin þarf á því að halda.</string>
    <string name="tutorial_capitals_text">Strjúktu upp á staf og hann skrifast sem hástafur. Skrifaðu tvo hástafi.</string>
    <string name="tutorial_caps_title">Bara hástafir</string>
    <string name="tutorial_caps_text">Shift (⇧) er í raun caps lock: ýttu einu sinni og hver stafur verður hástafur þar til þú ýtir aftur. Skrifaðu hvaða 5 hástafi sem er – með Shift eða með því að strjúka upp, skiptir ekki máli.</string>
    <string name="tutorial_punctuation_text">Strjúktu upp á . fyrir kommu og á ? fyrir upphrópunarmerki. Skrifaðu bæði.</string>
    <string name="tutorial_delete_title">Eyða með stroku</string>
    <string name="tutorial_delete_text">Strjúktu til vinstri yfir lyklana eða svæðið í kringum þá – því lengri stroka, því hraðar eyðist.</string>
    <string name="tutorial_restore_title">Fáðu textann aftur</string>
    <string name="tutorial_restore_text">Skrifaðu einn staf eða tákn, strjúktu til vinstri til að eyða því og til hægri til að fá það aftur. Gerðu þetta 3 sinnum.</string>
    <string name="tutorial_long_press_text">Haltu lykli inni, renndu að sérstaf og lyftu fingrinum. Skrifaðu einn sérstaf.</string>
    <string name="tutorial_long_press_example">Sérstafir tungumálsins þíns – haltu inni einhverjum af þessum lyklum:\n%1$s</string>
    <string name="tutorial_emoji_text">Strjúktu upp á 123 (eða ýttu á 😊) og veldu tjákn.</string>
    <string name="tutorial_sample_text">Antara</string>
    <string name="tutorial_swap_title">Þín eigin stafauppröðun</string>
    <string name="tutorial_swap_text">„%1$s“: ýttu á tvo lykla (eða dragðu annan á hinn) og þeir skipta um stað. QWERTY, AZERTY og önnur snið eru þar líka.</string>
    <string name="tutorial_bind_title">Tjákn með löngu ýti</string>
    <string name="tutorial_bind_text">„%1$s“: ýttu á lykil og bættu við hvaða tjákni, staf eða eigin texta sem er – það birtist þegar þú heldur lyklinum inni.</string>
    <string name="tutorial_themes_title">Þemu og bakgrunnur</string>
    <string name="tutorial_themes_text">„%1$s“: ljóst, dökkt, gegnsætt eða hreyfanlegt RGB. „%2$s“: litaðu hvern hluta lyklaborðsins.</string>
    <string name="tutorial_features_title">Hvað þú getur gert fleira</string>
    <string name="tutorial_help_note">Viltu sjá þetta aftur? „%1$s“ (?) → neðst.</string>
    <string name="help_group_keyboard">Lyklaborð</string>
    <string name="help_group_app">Forrit</string>
    <string name="help_group_gestures">Bendingar á lyklaborðinu</string>
    <string name="help_enable">Kveikir á Antara-lyklaborðinu í lyklaborðalista Android. Þarf einu sinni eftir uppsetningu.</string>
    <string name="help_choose">Gerir Antara að lyklaborðinu sem þú skrifar með. Þú getur líka skipt um lyklaborð með lyklaborðstákninu á yfirlitsstikunni.</string>
    <string name="help_key_shape">Sexhyrndir, þríhyrndir, kringlóttir eða teningslaga lyklar. Forskoðunin fyrir neðan sýnir valið form.</string>
    <string name="help_rows">3, 4 eða 5 lyklaraðir. Uppsetningar, hliðarhnappar og stafir við langt ýt fylgja fjölda raða.</string>
    <string name="help_key_height">Gerir lyklana hærri eða lægri. Aðeins hæðin breytist, aldrei breiddin eða bilið milli lykla.</string>
    <string name="help_row_spacing">Bætir við eða minnkar bilið milli lyklaraða. Ekkert annað breytist.</string>
    <string name="help_side_offsets">Færir hliðarhnappana aðeins til vinstri eða hægri, t.d. frá ávölum skjábrún, sér fyrir lóðrétta og lárétta stöðu.</string>
    <string name="help_layout_keys">Veldu forstillingu (QWERTZ, QWERTY, AZERTY, Dvorak…) eða raðaðu stöfunum sjálf(ur): ýttu á tvo lykla eða dragðu einn á annan til að víxla þeim. Talnauppsetningin er fyrir neðan; 0–9, ABC og Enter er aðeins hægt að færa.</string>
    <string name="help_layout_side">Hnapparnir við skjábrúnirnar. Ýttu á einn til að gefa honum aðgerð (Shift, Backspace, Enter, bil, staf eða emoji-valið), dragðu þá til að breyta röðinni.</string>
    <string name="help_layout_horizontal">Táknin á milli lyklaborðshelminganna í láréttri stöðu. Hverju þeirra má breyta eða skilja eftir autt.</string>
    <string name="help_layout_emoji">Hvar emoji-flokkarnir birtast, og röð og hlið hnappanna fyrir loka, eyða og bil.</string>
    <string name="help_saved_layouts">Vistaðar uppsetningar og afritin sem verða til við endurstillingu og innflutning. Forskoðaðu, endurheimtu uppsetningu og/eða liti, endurnefndu eða eyddu.</string>
    <string name="help_lp_alphabet">Ef haldið er á staf birtast fleiri stafir. Ýttu hér á lykil til að bæta við hann sérstöfum, táknum eða emoji.</string>
    <string name="help_lp_numeric">Það sama fyrir lykla talnauppsetningarinnar.</string>
    <string name="help_lp_my_binds">Allir lyklar með stafi við langt ýt á einum lista. Ýttu á einn til að breyta honum.</string>
    <string name="help_lp_custom">Setur hvaða texta sem er á langt ýt lykils, t.d. netfangið þitt eða heil skilaboð. Hann er sleginn inn nákvæmlega eins og hann er skrifaður.</string>
    <string name="help_colors_space">Litur bilstanganna: litur þemans, báðar eins eða hvor með sinn.</string>
    <string name="help_colors_enter">Bakgrunns- og táknlitur Enter. Valinn stafur í glugga fyrir langt ýt notar þá líka.</string>
    <string name="help_colors_side">Tákn- og bakgrunnslitur hliðarhnappanna, eða enginn bakgrunnur.</string>
    <string name="help_colors_keys">Einn litur fyrir alla lykla, eða ýttu á lykil til að gefa honum eigin lit.</string>
    <string name="help_colors_background">Bakgrunnur lyklaborðs: eftir þema, dökkur, ljós eða þinn eigin litur.</string>
    <string name="help_colors_theme_defaults">Litirnir sem ljósa og dökka þemað nota alls staðar þar sem kveikt er á litum þemans.</string>
    <string name="help_language">Tungumál forritsins og stafa lyklaborðsins (latneskt, kyrillískt eða grískt). Á lyklaborðinu skiptirðu um það með því að halda báðum bilstöngunum í 4 sekúndur.</string>
    <string name="help_theme">Ljóst eða Dökkt, gegnsær bakgrunnur, Sérsniðið (vistaðar uppsetningar) eða hreyfðu RGB Smooth og RGB Wild.</string>
    <string name="help_rgb">Hraði, mettun og birta RGB-hreyfimyndarinnar.</string>
    <string name="help_vibration">Stuttur titringur við hvert lyklaýt.</string>
    <string name="help_suggestions">Allt að þrjú orð fyrir ofan lyklana; ýttu á eitt til að nota það. Engin sjálfvirk leiðrétting og ekkert sem þú skrifar er vistað.</string>
    <string name="help_reset">Litir, uppsetning eða hvort tveggja í sjálfgefið. Núverandi staða er fyrst vistuð í Vistaðar uppsetningar; stafir við langt ýt og lögun lykla haldast.</string>
    <string name="help_export">Vistar allar stillingar í skrá, t.d. til að flytja þær í nýjan síma. Nýleg emoji fylgja ekki.</string>
    <string name="help_import">Hleður stillingum úr útfluttri skrá. Núverandi stillingar eru geymdar sem afrit í Vistaðar uppsetningar.</string>
    <string name="help_about">Útgáfa, persónuvernd og leyfi opins hugbúnaðar.</string>
    <string name="help_q_capitals">Hástafir</string>
    <string name="help_capitals">Strjúktu upp á staf fyrir einn hástaf. Shift heldur hástöfum á þar til þú ýtir á hann aftur.</string>
    <string name="help_q_delete">Eyða og endurheimta texta</string>
    <string name="help_delete">Strjúktu til vinstri á lyklunum eða bilinu í kringum þá til að eyða, til hægri til að fá textann aftur. Því lengri stroka, því hraðar. Að halda Backspace eyðir líka.</string>
    <string name="help_q_special">Sérstafir</string>
    <string name="help_special">Haltu lykli, renndu að staf og lyftu fingrinum.</string>
    <string name="help_q_punctuation">Komma og upphrópunarmerki</string>
    <string name="help_punctuation">Strjúktu upp á . fyrir kommu og á ? fyrir upphrópunarmerki.</string>
    <string name="help_q_emoji">Emoji</string>
